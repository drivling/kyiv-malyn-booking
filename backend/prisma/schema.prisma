
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Schedule {
  id            Int      @id @default(autoincrement())
  route         String   // "Kyiv-Malyn-Irpin", "Malyn-Kyiv-Irpin", "Kyiv-Malyn-Bucha", "Malyn-Kyiv-Bucha"
  departureTime String   // Формат "HH:MM" (наприклад "08:00")
  maxSeats      Int      @default(20) // Максимальна кількість місць
  supportPhone  String?  // Телефон підтримки для уточнення бронювання (напр. +380(93) 170 18 35), для напрямків з Києвом
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([route, departureTime])
}

// Єдина база людей: прив'язка номера до імені та Telegram для всіх сценаріїв
model Person {
  id                    Int       @id @default(autoincrement())
  phoneNormalized       String    @unique // Нормалізований номер (380XXXXXXXXX)
  fullName              String?   // Ім'я та прізвище
  telegramChatId        String?   // Для відправки повідомлень в Telegram
  telegramUserId        String?   // Ідентифікатор користувача в Telegram
  telegramUsername      String?   // @username з Telegram (з групи PoDoroguem)
  telegramPromoSentAt     DateTime? // Коли одноразово відправлено промо від вашого акаунта (щоб не спамити)
  telegramReminderSentAt  DateTime? // Остання дата нагадування/реклами для Telegram-клієнтів (щоб не спамити)
  /// Коли зафіксовано, що користувач заблокував бота (outbound send). Для вибірок і аудиту; chat/user id очищені.
  telegramBotBlockedAt    DateTime?
  createdAt               DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  /// Унікальний код для реферального посилання (?start=ref_CODE)
  referralCode          String?   @unique
  /// Хто запросив цього користувача (фіксується один раз при реєстрації)
  referredByPersonId    Int?
  referredByPerson      Person?   @relation("PersonReferrals", fields: [referredByPersonId], references: [id], onDelete: SetNull)
  referredPersons       Person[]  @relation("PersonReferrals")
  /// Чи можна нарахувати 10 грн «за нового друга»: false — уже був у базі клієнтів
  referralRegistrationBonusEligible Boolean?

  bookings     Booking[]
  viberListings ViberListing[]
  viberRideEvents ViberRideEvent[]
  referralInvitesSent     ReferralInvite[] @relation("ReferrerInvites")
  referralInvitesReceived ReferralInvite[] @relation("ReferredInvites")
  referralRewardsAsReferrer ReferralReward[] @relation("ReferrerRewards")
  referralRewardsAsReferred ReferralReward[] @relation("ReferredRewards")
  rideCompletionProofs    RideCompletionProof[]

  @@index([telegramUsername])
  @@index([referredByPersonId])
}

/// Запрошення друга (номер, @username або посилання)
model ReferralInvite {
  id               Int       @id @default(autoincrement())
  referrerId       Int
  inviteContact    String    // як ввів користувач
  inviteType       String    // "phone" | "telegram" | "link"
  invitePhoneNorm  String?
  inviteUsername   String?
  referredPersonId Int?
  status           String    @default("pending") // pending | registered | expired | blocked_self_referral
  /// false — контакт уже був у Person (без бота); 10 грн за залучення не буде
  registrationBonusEligible Boolean @default(true)
  registeredAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  referrer       Person  @relation("ReferrerInvites", fields: [referrerId], references: [id], onDelete: Cascade)
  referredPerson Person? @relation("ReferredInvites", fields: [referredPersonId], references: [id], onDelete: SetNull)

  @@index([referrerId])
  @@index([invitePhoneNorm])
  @@index([inviteUsername])
  @@index([referredPersonId])
}

/// Нарахування винагороди рефереру за дії запрошеного друга
model ReferralReward {
  id               Int       @id @default(autoincrement())
  referrerId       Int
  referredPersonId Int
  rewardType       String    // registration | driver_qualified | passenger_completed_ride | passenger_self_confirm (legacy: driver_first_listing)
  amountUah        Int
  viberListingId   Int?
  rideProofId      Int?
  /// hold — чекає схвалення фото (у виплати не йде); approved — у черзі виплат; legacy: pending
  status           String    @default("hold") // hold | approved | paid | flagged
  flagReason       String?   @db.Text
  /// Нотатка адміна при виплаті (напр. «картка Приват 04.08»)
  payoutNote       String?
  createdAt        DateTime  @default(now())
  paidAt           DateTime?

  referrer       Person              @relation("ReferrerRewards", fields: [referrerId], references: [id], onDelete: Cascade)
  referredPerson Person              @relation("ReferredRewards", fields: [referredPersonId], references: [id], onDelete: Cascade)
  viberListing   ViberListing?       @relation(fields: [viberListingId], references: [id], onDelete: SetNull)
  rideProof      RideCompletionProof? @relation(fields: [rideProofId], references: [id], onDelete: SetNull)

  /// Одна нагорода одного типу на пару людей у межах заявки — захист від гонки (альбом з двох фото)
  @@unique([referrerId, referredPersonId, rewardType, rideProofId], map: "ReferralReward_dedupe_key")
  @@index([referrerId])
  @@index([referredPersonId])
  @@index([status])
}

/// Підтвердження поїздки пасажиром (фото на старті та після) — для акції та рекламного посту
model RideCompletionProof {
  id                 Int       @id @default(autoincrement())
  personId           Int
  viberListingId     Int?
  route              String
  rideDate           DateTime
  departureTime      String?
  photoStartFileId   String?
  photoEndFileId     String?
  status             String    @default("awaiting_photos") // awaiting_photos | pending_review | approved | rejected | flagged
  rejectionReason    String?
  flagReason         String?   @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  person       Person           @relation(fields: [personId], references: [id], onDelete: Cascade)
  viberListing ViberListing?    @relation(fields: [viberListingId], references: [id], onDelete: SetNull)
  referralRewards ReferralReward[]

  @@index([personId])
  @@index([status])
}

model Booking {
  id              Int       @id @default(autoincrement())
  route           String
  date            DateTime
  departureTime   String   // Час відправлення у форматі "HH:MM"
  seats           Int
  name            String   // Денормалізовано для відображення; джерело істини — Person
  phone           String   // Денормалізовано; джерело істини — Person.phoneNormalized
  telegramChatId  String?  // Копія з Person для зворотної сумісності
  telegramUserId  String?  // Копія з Person для зворотної сумісності
  scheduleId      Int?     // Посилання на графік (опціонально)
  personId        Int?     // Посилання на людину (єдине джерело імені/телефону/Telegram)
  source          String   @default("schedule") // "schedule" — маршрутка, "viber_match" — попутка (водій підтвердив)
  viberListingId  Int?     // Якщо source=viber_match — оголошення водія (ViberListing)
  createdAt       DateTime @default(now())

  person       Person?       @relation(fields: [personId], references: [id], onDelete: SetNull)
  viberListing ViberListing? @relation(fields: [viberListingId], references: [id], onDelete: SetNull)
}

// Запит пасажира на бронювання у водія (пряме співпадіння). Водій має 1 год на підтвердження.
model RideShareRequest {
  id                  Int      @id @default(autoincrement())
  passengerListingId  Int
  driverListingId     Int
  status              String   // "pending" | "confirmed" | "expired" | "rejected"
  expiresAt           DateTime
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  passengerListing ViberListing @relation("RideShareAsPassenger", fields: [passengerListingId], references: [id], onDelete: Cascade)
  driverListing    ViberListing @relation("RideShareAsDriver", fields: [driverListingId], references: [id], onDelete: Cascade)
}

model ViberListing {
  id            Int      @id @default(autoincrement())
  rawMessage    String   @db.Text // Оригінальне повідомлення з чату
  source        String   @default("Viber1") // "Viber1" — з Viber, "telegram1" — з Telegram (PoDoroguem)
  senderName    String?  // Ім'я відправника (деноралізовано; джерело — Person)
  listingType   String   // "driver" або "passenger"
  route         String   // Напрямок (наприклад "Київ-Малин", "Малин-Київ")
  date          DateTime // Дата поїздки
  departureTime String?  // Час відправлення (може бути діапазон "18:00-18:30")
  seats         Int?     // Кількість місць (для пасажира) або вільних місць (для водія)
  phone         String   // Контактний номер (деноралізовано; джерело — Person)
  notes         String?  // Додаткові примітки (наприклад "від м Почайна")
  priceUah      Int?     // Ціна в гривнях (опціонально)
  isActive      Boolean  @default(true) // Чи активне оголошення
  personId      Int?     // Посилання на людину
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  person                   Person?            @relation(fields: [personId], references: [id], onDelete: SetNull)
  bookingsFromRideShare    Booking[]
  rideShareRequestsAsPassenger RideShareRequest[] @relation("RideShareAsPassenger")
  rideShareRequestsAsDriver   RideShareRequest[] @relation("RideShareAsDriver")
  matchNotifyAsPassenger      ViberMatchPairNotification[] @relation("MatchNotifyPassengerListing")
  matchNotifyAsDriver         ViberMatchPairNotification[] @relation("MatchNotifyDriverListing")
  referralRewards             ReferralReward[]
  rideCompletionProofs        RideCompletionProof[]
}

/// Щоб не дублювати сповіщення про ту саму пару пасажир↔водій (бот + /checkclients + імпорти).
model ViberMatchPairNotification {
  id                  Int       @id @default(autoincrement())
  passengerListingId  Int
  driverListingId     Int
  /// Пасажир уже отримав повідомлення «є водій» для цієї пари
  passengerNotifiedAt DateTime?
  /// Водій уже отримав повідомлення «є пасажир» для цієї пари
  driverNotifiedAt    DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  passengerListing ViberListing @relation("MatchNotifyPassengerListing", fields: [passengerListingId], references: [id], onDelete: Cascade)
  driverListing    ViberListing @relation("MatchNotifyDriverListing", fields: [driverListingId], references: [id], onDelete: Cascade)

  @@unique([passengerListingId, driverListingId])
}

/// Аналітичні події, згенеровані з історичної таблиці "ViberRide" (окремий сервіс парсингу).
/// Кожен рядок = одна "подія поїздки" з прив'язкою до телефону/Person та часовими ознаками.
model ViberRideEvent {
  id              Int       @id @default(autoincrement())
  /// Первинний ключ з історичної таблиці "ViberRide"
  viberRideId     Int
  /// Телефон з вихідних даних (як є)
  contactPhone    String
  /// Нормалізований телефон (380XXXXXXXXX) для зв'язку з Person
  phoneNormalized String
  /// Зв'язок з єдиною базою людей (може бути відсутній, якщо Person ще не створений)
  personId        Int?

  /// Напрямок (наприклад "Kyiv-Malyn", "Malyn-Kyiv") — з "ViberRide.route"
  route           String?
  /// Дата поїздки
  departureDate   DateTime?
  /// Час/інтервал відправлення у вихідному вигляді (наприклад "18:00" або "18:00-18:30")
  departureTime   String?
  /// Кількість вільних/потрібних місць
  availableSeats  Int?
  /// Ціна в гривнях (якщо вдалося розпарсити)
  priceUah        Int?
  /// Чи успішно розпарсено повідомлення
  isParsed        Boolean
  /// Чи вважається поїздка "активною" у вихідній таблиці (може бути відсутнє)
  isActive        Boolean?
  /// Текстова інформація про помилки парсингу
  parsingErrors   String?

  /// День тижня (0–6) за датою поїздки, для швидкої аналітики
  weekday         Int?
  /// Година відправлення (0–23) — початок інтервалу, якщо був діапазон
  hour            Int?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  person          Person?   @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@unique([viberRideId])
}

/// Помилки відправки через персональний акаунт (send_message.py): PRIVACY_PREMIUM_REQUIRED тощо
model TelegramUserSendError {
  id          Int      @id @default(autoincrement())
  contact     String   // Телефон або @username
  contactType String   // "phone" | "username"
  errorCode   Int      // Код виходу Python (2 = PRIVACY_PREMIUM_REQUIRED тощо)
  errorText   String?  @db.Text // stderr з send_message.py
  createdAt   DateTime @default(now())
}

/// Реферальний код із ?start=ref_CODE, поки людина ще не надіслала номер телефону.
/// У БД, а не в памʼяті: інакше деплой між переходом за посиланням і реєстрацією губить реферера.
model PendingReferralCode {
  id               Int      @id @default(autoincrement())
  telegramChatId   String   @unique
  code             String
  referrerPersonId Int
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  @@index([expiresAt])
}

/// Налаштування акції «Приведи друга». Використовується один рядок (найменший id).
model ReferralProgramSettings {
  id        Int      @id @default(autoincrement())
  /// Загальний бюджет акції, грн. Понад нього нагороди створюються на утриманні
  budgetUah Int      @default(4000)
  updatedAt DateTime @updatedAt
}

/// Останній імпорт з Telegram групи PoDoroguem — щоб парсити тільки нові повідомлення
model TelegramFetchState {
  id             Int      @id @default(autoincrement())
  topicId        Int      @unique // 2, 6, 108
  lastMessageId  Int      @default(0) // останній оброблений message ID
  updatedAt      DateTime @updatedAt
}

/// День замовлення обідів (група «Обіди для НЕ бідних»)
model LunchDay {
  id             Int       @id @default(autoincrement())
  /// Календарна дата замовлення (Europe/Kyiv)
  date           DateTime  @db.Date
  /// open | ordering | closed
  status         String    @default("open")
  menuMessageId  BigInt?
  menuPhotoPath  String?
  parsedRawJson  String?   @db.Text
  payeeCard      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  menuItems LunchMenuItem[]
  orders    LunchOrder[]
  payments  LunchPayment[]

  @@unique([date])
}

model LunchMenuItem {
  id        Int      @id @default(autoincrement())
  dayId     Int
  name      String
  /// Нормалізована назва для матчингу
  nameNorm  String
  /// Ціна в гривнях (ціле)
  priceUah  Int
  createdAt DateTime @default(now())

  day   LunchDay         @relation(fields: [dayId], references: [id], onDelete: Cascade)
  lines LunchOrderLine[]

  @@index([dayId])
  @@index([dayId, nameNorm])
}

model LunchParticipant {
  id             Int      @id @default(autoincrement())
  telegramUserId String   @unique
  displayName    String
  username       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders   LunchOrder[]
  payments LunchPayment[]
}

model LunchOrder {
  id              Int      @id @default(autoincrement())
  dayId           Int
  participantId   Int
  sourceMessageId BigInt?
  /// Повний оригінальний текст повідомлення (для аналізу)
  rawText         String   @db.Text
  /// Фрагменти, які автомат не зіставив з меню
  unmatchedText   String?  @db.Text
  totalUah        Int      @default(0)
  /// active | cancelled
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  day         LunchDay         @relation(fields: [dayId], references: [id], onDelete: Cascade)
  participant LunchParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  lines       LunchOrderLine[]

  @@unique([dayId, participantId])
  @@index([dayId])
  @@index([participantId])
}

model LunchOrderLine {
  id           Int    @id @default(autoincrement())
  orderId      Int
  menuItemId   Int?
  rawName      String
  qty          Int    @default(1)
  unitPriceUah Int
  lineTotalUah Int

  order    LunchOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem LunchMenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model LunchPayment {
  id              Int      @id @default(autoincrement())
  dayId           Int
  participantId   Int
  amountUah       Int
  sourceMessageId BigInt?
  rawText         String   @db.Text
  createdAt       DateTime @default(now())

  day         LunchDay         @relation(fields: [dayId], references: [id], onDelete: Cascade)
  participant LunchParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([dayId])
  @@index([participantId])
  @@index([dayId, participantId])
}

/// Черга повідомлень у групу обідів (щоб не відкривати другу Telethon-сесію паралельно з listener)
model LunchOutboundMessage {
  id        Int       @id @default(autoincrement())
  text      String    @db.Text
  /// pending | sent | failed
  status    String    @default("pending")
  errorText String?   @db.Text
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([status, createdAt])
}

/// Адмін-задачі для listener (reparse_today тощо)
model LunchAdminJob {
  id          Int       @id @default(autoincrement())
  /// reparse_today
  type        String
  /// pending | done | failed
  status      String    @default("pending")
  resultJson  String?   @db.Text
  errorText   String?   @db.Text
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([status, createdAt])
}
