# Локальна БД з docker-compose.dev.yml (npm run db:up): порт 5433, логін/пароль booking
DATABASE_URL="postgresql://booking:booking@localhost:5433/booking"
ADMIN_PASSWORD="admin123"

# Telegram Bot (опціонально)
# Отримайте токен від @BotFather в Telegram
TELEGRAM_BOT_TOKEN=""
# Chat ID адміністратора (для отримання нотифікацій)
# Отримайте ваш chat_id від @userinfobot
TELEGRAM_ADMIN_CHAT_ID=""
# 0 — не піднімати lunch-listener разом з бекендом (зручно локально)
LUNCH_LISTENER_ENABLED="0"

# Одноразове промо від вашого акаунта (якщо користувача немає в боті) — див. backend/telegram-user/README.md
# Сесія: на Railway — TELEGRAM_USER_SESSION_BASE64 (значення з `python3 auth_session.py --export`), backend пише її у файл
# під час старту; локально — файл backend/telegram-user/session_telegram_user.session (у git не потрапляє).
# Одна сесія — одне місце: та сама сесія з двох IP одночасно = AuthKeyDuplicatedError і новий вхід.
# TELEGRAM_USER_SESSION_BASE64=""
# TELEGRAM_API_ID="35076972"
# TELEGRAM_API_HASH="9b47fc0d11ed33c59e16047d084da56b"
# Опційно, якщо сесія в іншому місці: TELEGRAM_USER_SESSION_PATH="/шлях/до/session_telegram_user"
# TELEGRAM_USER_PYTHON="python3"
# Листи від особистого акаунта за числовим id (автори без username і номера): 0 — вимкнути; ліміт на добу (Київ)
# TELEGRAM_USER_DM_BY_ID=1
# TELEGRAM_USER_DM_BY_ID_DAILY_CAP=20

# Обіди (python3 -m lunch.listener) — див. telegram-user/lunch/README.md
# LUNCH_GROUP_ID="-5427750954"
# OPENAI_API_KEY=""
# LUNCH_OPERATOR_IDS=""
# LUNCH_OCR_MODEL="gpt-4o-mini"
# LUNCH_LISTENER_ENABLED="1"   # 0 — вимкнути автозапуск listener разом з backend

# «Джура» (читання обраних чатів у базу, /admin/dzhura) живе всередині lunch.listener — див. Docs/dzhura-roadmap.md
# DZHURA_ENABLED="1"   # 0 — не підключати Джуру до слухача (лунч працює як раніше)
