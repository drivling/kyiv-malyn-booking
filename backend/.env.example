# Локальна БД з docker-compose.dev.yml (npm run db:up): порт 5433, логін/пароль booking
DATABASE_URL="postgresql://booking:booking@localhost:5433/booking"
ADMIN_PASSWORD="admin123"

# Telegram Bot (опціонально)
# Отримайте токен від @BotFather в Telegram
TELEGRAM_BOT_TOKEN=""
# Chat ID адміністратора (для отримання нотифікацій)
# Отримайте ваш chat_id від @userinfobot
TELEGRAM_ADMIN_CHAT_ID=""
# 0 — не піднімати lunch-listener разом з бекендом (зручно локально)
LUNCH_LISTENER_ENABLED="0"

# Одноразове промо від вашого акаунта (якщо користувача немає в боті) — див. backend/telegram-user/README.md
# Сесія: на Railway — TELEGRAM_USER_SESSION_BASE64 (значення з `python3 auth_session.py --export`), backend пише її у файл
# під час старту; локально — файл backend/telegram-user/session_telegram_user.session (у git не потрапляє).
# Одна сесія — одне місце: та сама сесія з двох IP одночасно = AuthKeyDuplicatedError і новий вхід.
# TELEGRAM_USER_SESSION_BASE64=""
# TELEGRAM_API_ID="35076972"
# TELEGRAM_API_HASH="9b47fc0d11ed33c59e16047d084da56b"
# Опційно, якщо сесія в іншому місці: TELEGRAM_USER_SESSION_PATH="/шлях/до/session_telegram_user"
# TELEGRAM_USER_PYTHON="python3"
# Листи від особистого акаунта за числовим id (автори без username і номера): 0 — вимкнути; ліміт на добу (Київ)
# TELEGRAM_USER_DM_BY_ID=1
# TELEGRAM_USER_DM_BY_ID_DAILY_CAP=20

# Обіди (python3 -m lunch.listener) — див. telegram-user/lunch/README.md
# LUNCH_GROUP_ID="-5427750954"
# ANTHROPIC_API_KEY=""        # OCR меню з фото (Claude; кредити API з плану Max — Console → API keys)
# ANTHROPIC_WORKSPACE_ID=""   # wrkspc_… — лише для ключа рівня організації (без воркспейсу)
# LUNCH_OPERATOR_IDS=""
# LUNCH_OCR_MODEL="claude-haiku-5-5"  # кожне фото/PDF і суми чеків; лише claude-*; за замовч. дешева claude-haiku-5-5
# LUNCH_MENU_MODEL="claude-opus-5-5"  # меню перечитує дорога: дешева плутає ціни між рядками
# LUNCH_LISTENER_ENABLED="1"   # 0 — вимкнути автозапуск listener разом з backend

# «Джура» (читання обраних чатів у базу, /admin/dzhura) живе всередині lunch.listener — див. Docs/dzhura-roadmap.md
# DZHURA_ENABLED="1"   # 0 — не підключати Джуру до слухача (лунч працює як раніше)
# Автовідповідь в особистих чатах (галочка в /admin/dzhura; потребує ANTHROPIC_API_KEY) — dzhura/README.md
# DZHURA_AUTOREPLY_ENABLED="1"            # 0 — вимкнути всюди
# DZHURA_AUTOREPLY_MODEL="claude-opus-5-5" # лише claude-*
# DZHURA_AUTOREPLY_DAILY_CAP="40"         # автовідповідей на один чат за київську добу
# «Доведе» (/dovede): розбір питання через Claude — POST /dovede/understand (Docs/dovede-roadmap.md, «Доступ»).
# Ключ — той самий ANTHROPIC_API_KEY (і ANTHROPIC_WORKSPACE_ID); без ключа сторінка працює на словнику в браузері.
# Доступ: поки DOVEDE_PUBLIC не ON, сторінка просить пароль запрошених (адмін заходить і без нього).
# DOVEDE_PUBLIC="ON"                # ON — відкрито всім (публічний запуск)
# DOVEDE_PASSWORD=""                # пароль для запрошених, окремий від ADMIN_PASSWORD; зміна відкликає видані токени
# DOVEDE_ENABLED="1"                # 0 — не кликати Claude
# DOVEDE_MODEL="claude-opus-5-5"    # лише claude-*
# DOVEDE_DAILY_CAP="300"            # викликів Claude за київську добу
# Час попуток у «Доведе»: з ключем — Google Routes із заторами, без нього — «Авто в дорозі, хв» маршруту (типово 95)
# GOOGLE_MAPS_API_KEY=""
# DRIVE_TIME_DAILY_CAP="200"        # запитів до Google Routes за добу; 0 — лише сталий час
# «Доведе» · дорога містом (Київ, Житомир) до місця «словами»: своя база, а чого немає — Google Routes (той самий GOOGLE_MAPS_API_KEY)
# DOVEDE_CITY_ROUTES="google"       # off — не шукати містом зовсім (сторінка покаже кнопку Google Maps)
# DOVEDE_CITY_STORE="1"             # 0 — питати Google, але нічого не писати в базу
# DOVEDE_CITY_DAILY_CAP="150"       # запитів до Google за київську добу (фонове навчання бере не більше половини)
# DOVEDE_CITY_LEARN_INTERVAL_MIN="60" # фонове навчання: оновлювати найзапитуваніші пари; 0 — вимкнено
# DOVEDE_CITY_REFRESH="1"           # 0 — фонове навчання не оновлює збережені відповіді, що застаріли (строк — в адмінці «Місто»)
# DOVEDE_CITY_OWN="1"               # 0 — не відповідати прямою поїздкою Житомиром зі своїх даних (маршрути сайту, хвилини за Google)
