# API бекенду
# Локально: http://localhost:3000 (бекенд з `npm run dev:backend`)
# Production: задається в Railway Variables, напр. https://kyiv-malyn-booking-production.up.railway.app
VITE_API_URL=http://localhost:3000

# Telegram Bot Username (без @)
VITE_TELEGRAM_BOT_USERNAME=your_bot_username

# Тайли публічної карти /transport (необовʼязково). За замовчуванням — OpenStreetMap без ключа.
# CARTO Positron потребує API-ключа (carto.com/basemaps/apikey): без нього кожен тайл — «API KEY REQUIRED».
# VITE_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_TILES_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
