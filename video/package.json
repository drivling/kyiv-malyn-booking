{
  "name": "dovede-teaser-video",
  "private": true,
  "description": "Тизер «Доведе.»: зйомка інтерфейсу (capture/) і монтаж у Remotion (src/). Docs/dovede-teaser/roadmap.md",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "capture": "node capture/run.mjs",
    "fixtures": "node capture/refresh-fixtures.mjs",
    "metronome": "node scripts/metronome.mjs",
    "render:teaser": "remotion render src/index.ts Teaser out/teaser.mp4",
    "render:teaser15": "remotion render src/index.ts Teaser15 out/teaser-15.mp4",
    "render:draft": "remotion render src/index.ts Draft out/draft.mp4 --scale=0.75",
    "render:test": "remotion render src/index.ts StudioTest out/studio-test.mp4",
    "still:test": "remotion still src/index.ts StudioTest out/studio-test.png --frame=120",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/assets.mjs",
    "sound": "node scripts/sound.mjs",
    "analyze": "node scripts/analyze-track.mjs",
    "master": "node scripts/master.mjs",
    "music": "node scripts/music-edit.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "@remotion/google-fonts": "4.0.539",
    "@remotion/transitions": "4.0.539",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "typescript": "5.9.3"
  }
}
